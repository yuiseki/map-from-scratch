{
  // Node side: harness, bake helpers and bake scripts. Run directly by Node 24
  // (type stripping), checked by tsc in the image (bin/mfs test).
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "typeRoots": ["/usr/local/lib/node_modules/@types"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["kits/**/*.ts", "harness/**/*.ts", "tools/**/*.ts", "examples/*/bake.ts", "examples/*/*/bake.ts", "baselines/*/bake.ts", "vendor/earcut/*.d.ts"],
  "exclude": ["harness/page/**", "harness/probe/**"]
}
