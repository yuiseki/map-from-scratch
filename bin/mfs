#!/usr/bin/env bash
# Run the mfs harness inside Docker. The host needs only docker (and the
# nvidia container runtime for GPU examples).
#
#   bin/mfs image              (re)build the base image
#   bin/mfs image <toolchain>  (re)build mfs-<toolchain> from docker/Dockerfile.<toolchain>
#   bin/mfs <harness command>  see harness/cli.ts
#
# Environment:
#   MFS_TOOLCHAIN  run in mfs-<toolchain>:latest, built on top of the base
#                  image for the examples that need it (docker/README.md)
#   MFS_IMAGE    image to run          (default mfs-base:latest)
#   MFS_MEMORY   container memory cap  (default 8g)
#   MFS_CPUS     container CPU quota   (default 8)
#   MFS_PORT     host port for serve   (default 8080)
#   MFS_DISPLAY  headless or xvfb, overrides benchmarks.display of a browser run
#   MFS_SOURCES  host dir mounted read-only at the same path, for raw data
#                (default /sata_hdd_24tb when it exists)
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
BASE=mfs-base:latest

# A toolchain image extends the base one, so the base is built first.
build_toolchain() {
  local file="$ROOT/docker/Dockerfile.$1"
  [[ -f "$file" ]] || { echo "no toolchain $1 (docker/Dockerfile.$1)" >&2; exit 2; }
  docker image inspect "$BASE" >/dev/null 2>&1 || docker build -t "$BASE" "$ROOT/docker/base"
  docker build -t "mfs-$1:latest" --build-arg BASE="$BASE" -f "$file" "$ROOT/docker"
}

if [[ "${1:-}" == image ]]; then
  if [[ -n "${2:-}" ]]; then build_toolchain "$2"; exit; fi
  exec docker build -t "${MFS_IMAGE:-$BASE}" "$ROOT/docker/base"
fi
if [[ -n "${MFS_TOOLCHAIN:-}" ]]; then
  IMAGE=${MFS_IMAGE:-mfs-$MFS_TOOLCHAIN:latest}
  docker image inspect "$IMAGE" >/dev/null 2>&1 || build_toolchain "$MFS_TOOLCHAIN" >&2
else
  IMAGE=${MFS_IMAGE:-$BASE}
  docker image inspect "$IMAGE" >/dev/null 2>&1 || docker build -t "$IMAGE" "$ROOT/docker/base"
fi

args=(--rm --init -i
  --memory "${MFS_MEMORY:-8g}" --cpus "${MFS_CPUS:-8}" --shm-size 2g
  -u "$(id -u):$(id -g)" -e HOME=/tmp
  -v "$ROOT:$ROOT" -w "$ROOT")
[[ -t 0 && -t 1 ]] && args+=(-t)
if docker info --format '{{range $k,$v := .Runtimes}}{{$k}} {{end}}' | grep -qw nvidia; then
  args+=(--gpus all -e NVIDIA_DRIVER_CAPABILITIES=all)
else
  MFS_CHROME_FLAGS="${MFS_CHROME_FLAGS:---ignore-gpu-blocklist --use-angle=swiftshader --enable-unsafe-webgpu --enable-blink-features=CanvasDrawElement --disable-gpu-vsync --disable-frame-rate-limit}"
fi
SOURCES=${MFS_SOURCES-/sata_hdd_24tb}
[[ -n "$SOURCES" && -d "$SOURCES" ]] && args+=(-v "$SOURCES:$SOURCES:ro")
[[ "${1:-}" == serve ]] && args+=(-p "${MFS_PORT:-8080}:${2:-8080}")
[[ -n "${MFS_PAGE_QUERY:-}" ]] && args+=(-e "MFS_PAGE_QUERY=$MFS_PAGE_QUERY")
[[ -n "${MFS_DISPLAY:-}" ]] && args+=(-e "MFS_DISPLAY=$MFS_DISPLAY")
[[ -n "${MFS_CHROME_FLAGS:-}" ]] && args+=(-e "MFS_CHROME_FLAGS=$MFS_CHROME_FLAGS")
[[ -n "${DISPLAY:-}" && -d /tmp/.X11-unix ]] && args+=(-e "DISPLAY=$DISPLAY" -v /tmp/.X11-unix:/tmp/.X11-unix)

exec docker run "${args[@]}" "$IMAGE" node harness/cli.ts "$@"
